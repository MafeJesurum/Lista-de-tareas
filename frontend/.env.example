# Copiar como .env y ajustar los valores.

# Dirección de la API. En local es el back de Express;
# en producción (.env.production) es la IP pública de la EC2.
VITE_API_URL=http://localhost:3000/api

# true = usa datos de prueba en memoria mientras el back no está listo.
# Antes de entregar debe quedar en false.
VITE_USAR_DATOS_PRUEBA=false
